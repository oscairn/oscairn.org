---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadPackages, formatSize } from '../../../lib/packages.mjs';
export function getStaticPaths() {
  return loadPackages().map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const latest = p.versions[0];
const short = (s) => s.slice(0, 12);
// A version's platforms as links to its ready-made archives (plain links, labeled by platform, size beside when known).
const sizeNote = (e) => (e.size ? ` (about ${formatSize(e.size)})` : '');
---
<SiteLayout title={p.name} description={p.summary.slice(0, 200)} current="Packages">
<section style="border-top:0"><div class="wrap">
<p class="lab"><a href="/packages/" style="text-decoration:none">Packages</a> / {p.kind}</p>
<h1 style="font-size:clamp(32px,5vw,48px);margin:0 0 8px">{p.name}</h1>
<p class="mono" style="color:var(--muted);margin:0 0 16px">{p.id}</p>
<p class="lead">{p.summary}</p>
<div class="card spec">
<dl>
<div><dt>Latest version</dt><dd class="mono">{p.latest}</dd></div>
<div><dt>Kind</dt><dd>{p.kind}</dd></div>
<div><dt>Platforms</dt><dd class="mono">{latest.exports.length ? latest.exports.map((e, i) => <>{i > 0 && ', '}<a href={e.url}>{e.platform ?? 'any'}</a>{sizeNote(e)}</>) : (latest.platforms.join(', ') || 'any (content, no native builds)')}</dd></div>
<div><dt>License</dt><dd>{p.license}</dd></div>
<div><dt>Publisher</dt><dd>{p.publisher.name} <span class="mono">({p.publisher.id})</span></dd></div>
<div><dt>Source</dt><dd>{p.source ? <a href={p.source.url}>{p.source.url}</a> : 'not stated'}{p.source && <span class="mono"> at {short(p.source.revision)}</span>}</dd></div>
{p.tags.length > 0 && <div><dt>Tags</dt><dd class="mono">{p.tags.join(', ')}</dd></div>}
</dl>
</div>
<h2 style="margin-top:40px">Versions</h2>
<p class="eg">The instrument installs packages itself. The platform links are the ready-made archives of that version, one per platform, for installing by hand or offline from the Library (Install, File).{latest.exports.some((e) => e.size) ? ' Sizes are the repository index\'s, about the size of each file.' : ' Sizes are not shown: the published index could not be read when this page was built.'}</p>
<div class="tablewrap"><table class="pkgs">
<thead><tr><th>Version</th><th>Channel</th><th>Platforms</th><th>Archive file (all platforms)</th><th>Size</th><th>SHA-256</th><th>Source revision</th></tr></thead>
<tbody>
{p.versions.map((v) => (
<tr>
  <th scope="row" class="mono">{v.version}{v.yanked ? ' (yanked)' : ''}</th>
  <td>{v.channel}</td><td class="mono">{v.exports.length ? v.exports.map((e, i) => <>{i > 0 && <br />}<a href={e.url}>{e.platform ?? 'any'}</a>{sizeNote(e)}</>) : (v.platforms.join(', ') || 'any')}</td>
  <td class="mono">{v.archive.file}</td><td>{formatSize(v.archive.size)}</td>
  <td class="mono" title={v.archive.sha256}>{short(v.archive.sha256)}</td>
  <td class="mono">{v.source ? short(v.source.revision) : ''}</td>
</tr>))}
</tbody></table></div>
{latest.dependencies.length > 0 && <><h2 style="margin-top:40px">Needs</h2><ul class="mono">{latest.dependencies.map((d) => <li>{typeof d === 'string' ? d : (d.id ?? JSON.stringify(d))}</li>)}</ul></>}
</div></section>
<style is:global>
.spec dl{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px 32px}
.spec dt{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:4px}
.spec dd{margin:0;overflow-wrap:anywhere}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:8px;background:var(--surface)}
table.pkgs{border-collapse:collapse;width:100%;font-size:14px}
table.pkgs th,table.pkgs td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top}
table.pkgs thead th{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);white-space:nowrap}
table.pkgs tbody tr:last-child th,table.pkgs tbody tr:last-child td{border-bottom:0}
.mono{font-family:var(--mono);font-size:13px}
</style>
</SiteLayout>
