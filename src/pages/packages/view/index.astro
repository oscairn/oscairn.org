---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { PACKAGES_SITE } from '../../../../lib/config.mjs';
---
<SiteLayout title="Package" description="A package in the Oscairn repository." current="Packages">
<section style="border-top:0"><div class="wrap">
<div id="view" data-repo={PACKAGES_SITE}>
<p class="lab"><a href="/packages/" style="text-decoration:none">Packages</a></p>
<h1 id="v-title" style="font-size:clamp(32px,5vw,48px);margin:0 0 8px">Package</h1>
<p id="v-msg" class="lead">Reading the repository...</p>
<noscript><p class="lead">This page reads the package repository with JavaScript. Without it, see the <a href="/packages/">package list</a> or the <a href="https://github.com/oscairn/packages/tree/main/packages">repository</a>.</p></noscript>
<div id="v-body"></div>
</div>
</div></section>
<script>
  import '../../../scripts/package-view.js';
</script>
<style is:global>
.spec dl{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px 32px}
.spec dt{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:4px}
.spec dd{margin:0;overflow-wrap:anywhere}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:8px;background:var(--surface)}
table.pkgs{border-collapse:collapse;width:100%;font-size:14px}
table.pkgs th,table.pkgs td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);vertical-align:top}
table.pkgs thead th{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--accent);white-space:nowrap}
table.pkgs tbody tr:last-child th,table.pkgs tbody tr:last-child td{border-bottom:0}
.mono{font-family:var(--mono);font-size:13px}
.np{white-space:nowrap}
</style>
</SiteLayout>
