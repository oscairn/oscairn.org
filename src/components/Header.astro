---
// Starlight's header, replaced: the same bar as the other pages (see styles/header.css).
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import NavLinks from './NavLinks.astro';
import SiteMenu from './SiteMenu.astro';
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="sl-header">
  <SiteTitle />
  <NavLinks current="Docs" />
  <div class="tools"><Search /><ThemeSelect />{!hasSidebar && <SiteMenu current="Docs" />}</div>
</div>
<script>
  // /docs/#search (the search icon on the other pages) opens the search dialog.
  if (location.hash === '#search') {
    customElements.whenDefined('site-search').then(() => setTimeout(() => document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click(), 50));
  }
</script>
