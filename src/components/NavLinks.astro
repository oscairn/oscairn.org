---
import { GITHUB } from '../../lib/config.mjs';
const links = [['Docs', '/docs/'], ['Packages', '/packages/'], ['Devices', '/devices/'], ['Source', GITHUB]];
const { current, label = 'Site', variant = 'bar' } = Astro.props;
---
<nav class:list={['mainnav', variant, variant === 'bar' && 'desk']} aria-label={label}>
  {links.map(([l, href]) => <a href={href} aria-current={current === l ? 'page' : undefined}>{l}</a>)}
</nav>
